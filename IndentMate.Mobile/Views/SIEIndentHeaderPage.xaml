<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IndentMate.Mobile.Views.SIEIndentHeaderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:IndentMate.Mobile.ViewModels"
    BackgroundColor="#F4F7FB"
    Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:SIEIndentHeaderViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="20" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Padding="0,0,0,18">
            <Button
                BackgroundColor="Transparent"
                Clicked="OnBackClicked"
                FontSize="24"
                HeightRequest="42"
                Padding="0"
                Text="&#x2039;"
                TextColor="#172033"
                WidthRequest="42" />
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="22"
                Text="SIE Indent Header"
                TextColor="#172033"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14">
                <Label FontAttributes="Bold" FontSize="13" Text="Project" TextColor="#475467" />
                <VerticalStackLayout Spacing="0">
                    <Border BackgroundColor="White" Stroke="#D6DEE9" StrokeShape="RoundRectangle 8" StrokeThickness="1">
                        <Grid Padding="12" ColumnDefinitions="*,Auto" HeightRequest="48">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectProjectCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding SelectedProjectDisplay}" TextColor="#172033" VerticalOptions="Center" />
                            <Label Grid.Column="1" FontSize="18" Text="⌄" TextColor="#667085" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border BackgroundColor="White" IsVisible="{Binding ShowProjectOptions}" Stroke="#D6DEE9" StrokeShape="RoundRectangle 0,0,8,8" StrokeThickness="1">
                        <CollectionView HeightRequest="120" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12" RowDefinitions="Auto,Auto">
                                        <Label FontAttributes="Bold" Text="{Binding ProjectId}" TextColor="#172033" />
                                        <Label Grid.Row="1" FontSize="12" Text="{Binding Description}" TextColor="#667085" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <Label FontAttributes="Bold" FontSize="13" Text="Indent Type" TextColor="#475467" />
                <VerticalStackLayout Spacing="0">
                    <Border BackgroundColor="White" Stroke="#D6DEE9" StrokeShape="RoundRectangle 8" StrokeThickness="1">
                        <Grid Padding="12" ColumnDefinitions="*,Auto" HeightRequest="48">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectIndentTypeCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding SelectedIndentType}" TextColor="#172033" VerticalOptions="Center" />
                            <Label Grid.Column="1" FontSize="18" Text="⌄" TextColor="#667085" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border BackgroundColor="White" IsVisible="{Binding ShowIndentTypeOptions}" Stroke="#D6DEE9" StrokeShape="RoundRectangle 0,0,8,8" StrokeThickness="1">
                        <CollectionView HeightRequest="96" ItemsSource="{Binding IndentTypes}" SelectedItem="{Binding SelectedIndentType, Mode=TwoWay}" SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Padding="12" Text="{Binding .}" TextColor="#172033" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <Label FontAttributes="Bold" FontSize="13" Text="Warehouse" TextColor="#475467" />
                <Border
                    Padding="12"
                    BackgroundColor="#EEF2F7"
                    IsVisible="{Binding ShowAutoWarehouse}"
                    Stroke="#D6DEE9"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Label Text="{Binding AutoWarehouseDisplay}" TextColor="#172033" />
                </Border>
                <VerticalStackLayout IsVisible="{Binding ShowWarehousePicker}" Spacing="0">
                    <Border BackgroundColor="White" Stroke="#D6DEE9" StrokeShape="RoundRectangle 8" StrokeThickness="1">
                        <Grid Padding="12" ColumnDefinitions="*,Auto" HeightRequest="48">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectWarehouseCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding SelectedWarehouseDisplay}" TextColor="#172033" VerticalOptions="Center" />
                            <Label Grid.Column="1" FontSize="18" Text="⌄" TextColor="#667085" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border BackgroundColor="White" IsVisible="{Binding ShowWarehouseOptions}" Stroke="#D6DEE9" StrokeShape="RoundRectangle 0,0,8,8" StrokeThickness="1">
                        <CollectionView HeightRequest="120" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse, Mode=TwoWay}" SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12" RowDefinitions="Auto,Auto">
                                        <Label FontAttributes="Bold" Text="{Binding WarehouseCode}" TextColor="#172033" />
                                        <Label Grid.Row="1" FontSize="12" Text="{Binding Description}" TextColor="#667085" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <Label FontAttributes="Bold" FontSize="13" Text="From Location" TextColor="#475467" />
                <VerticalStackLayout Spacing="0">
                    <Border BackgroundColor="White" Stroke="#D6DEE9" StrokeShape="RoundRectangle 8" StrokeThickness="1">
                        <Grid Padding="12" ColumnDefinitions="*,Auto" HeightRequest="48">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectFromLocationCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding SelectedFromLocationDisplay}" TextColor="#172033" VerticalOptions="Center" />
                            <Label Grid.Column="1" FontSize="18" Text="⌄" TextColor="#667085" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border BackgroundColor="White" IsVisible="{Binding ShowFromLocationOptions}" Stroke="#D6DEE9" StrokeShape="RoundRectangle 0,0,8,8" StrokeThickness="1">
                        <CollectionView HeightRequest="120" ItemsSource="{Binding FromLocations}" SelectedItem="{Binding SelectedFromLocation, Mode=TwoWay}" SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Padding="12" Text="{Binding DisplayName}" TextColor="#172033" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <Label FontAttributes="Bold" FontSize="13" Text="To (Contractor)" TextColor="#475467" />
                <VerticalStackLayout Spacing="0">
                    <Border BackgroundColor="White" Stroke="#D6DEE9" StrokeShape="RoundRectangle 8" StrokeThickness="1">
                        <Grid Padding="12" ColumnDefinitions="*,Auto" HeightRequest="48">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectToContractorCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding SelectedToContractorDisplay}" TextColor="#172033" VerticalOptions="Center" />
                            <Label Grid.Column="1" FontSize="18" Text="⌄" TextColor="#667085" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border BackgroundColor="White" IsVisible="{Binding ShowToContractorOptions}" Stroke="#D6DEE9" StrokeShape="RoundRectangle 0,0,8,8" StrokeThickness="1">
                        <CollectionView HeightRequest="120" ItemsSource="{Binding ToContractors}" SelectedItem="{Binding SelectedToContractor, Mode=TwoWay}" SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Padding="12" Text="{Binding DisplayName}" TextColor="#172033" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <Label
                    FontSize="13"
                    IsVisible="{Binding HasError}"
                    Text="{Binding StatusMessage}"
                    TextColor="#D92D20" />

                <Button
                    Margin="0,8,0,0"
                    BackgroundColor="#1565D8"
                    Command="{Binding CreateRequestCommand}"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    Text="Create Request"
                    TextColor="White" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
