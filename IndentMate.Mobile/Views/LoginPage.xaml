<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IndentMate.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:IndentMate.Mobile.ViewModels"
    BackgroundColor="#F4F7FB"
    Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <Grid x:Name="RootLayout" Padding="24,18,24,28" RowDefinitions="Auto,*">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnUserInteraction" />
        </Grid.GestureRecognizers>

        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Start">
            <Grid ColumnDefinitions="40,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Border
                    HeightRequest="40"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    WidthRequest="40"
                    BackgroundColor="#1565D8">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="IM"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="IndentMate"
                    TextColor="#172033"
                    VerticalOptions="Center" />
            </Grid>

            <Button
                Grid.Column="2"
                Padding="0"
                BackgroundColor="Transparent"
                Command="{Binding GoToSetupCommand}"
                FontSize="24"
                HeightRequest="44"
                Text="&#x2699;"
                TextColor="#172033"
                WidthRequest="44" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="*,Auto,*">
            <VerticalStackLayout Grid.Row="1" Spacing="20">
                <Border
                    BackgroundColor="#1565D8"
                    HeightRequest="112"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="0"
                    WidthRequest="112">
                    <Label
                        FontAttributes="Bold"
                        FontSize="36"
                        HorizontalOptions="Center"
                        Text="IM"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="16" Margin="0,12,0,0">
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="ENTER PIN"
                        TextColor="#8A94A6" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="14">
                        <shapes:Ellipse Fill="#CED6E0" HeightRequest="16" WidthRequest="16">
                            <shapes:Ellipse.Triggers>
                                <DataTrigger Binding="{Binding PinDot1}" TargetType="shapes:Ellipse" Value="True">
                                    <Setter Property="Fill" Value="#1565D8" />
                                </DataTrigger>
                            </shapes:Ellipse.Triggers>
                        </shapes:Ellipse>
                        <shapes:Ellipse Fill="#CED6E0" HeightRequest="16" WidthRequest="16">
                            <shapes:Ellipse.Triggers>
                                <DataTrigger Binding="{Binding PinDot2}" TargetType="shapes:Ellipse" Value="True">
                                    <Setter Property="Fill" Value="#1565D8" />
                                </DataTrigger>
                            </shapes:Ellipse.Triggers>
                        </shapes:Ellipse>
                        <shapes:Ellipse Fill="#CED6E0" HeightRequest="16" WidthRequest="16">
                            <shapes:Ellipse.Triggers>
                                <DataTrigger Binding="{Binding PinDot3}" TargetType="shapes:Ellipse" Value="True">
                                    <Setter Property="Fill" Value="#1565D8" />
                                </DataTrigger>
                            </shapes:Ellipse.Triggers>
                        </shapes:Ellipse>
                        <shapes:Ellipse Fill="#CED6E0" HeightRequest="16" WidthRequest="16">
                            <shapes:Ellipse.Triggers>
                                <DataTrigger Binding="{Binding PinDot4}" TargetType="shapes:Ellipse" Value="True">
                                    <Setter Property="Fill" Value="#1565D8" />
                                </DataTrigger>
                            </shapes:Ellipse.Triggers>
                        </shapes:Ellipse>
                        <shapes:Ellipse Fill="#CED6E0" HeightRequest="16" WidthRequest="16">
                            <shapes:Ellipse.Triggers>
                                <DataTrigger Binding="{Binding PinDot5}" TargetType="shapes:Ellipse" Value="True">
                                    <Setter Property="Fill" Value="#1565D8" />
                                </DataTrigger>
                            </shapes:Ellipse.Triggers>
                        </shapes:Ellipse>
                        <shapes:Ellipse Fill="#CED6E0" HeightRequest="16" WidthRequest="16">
                            <shapes:Ellipse.Triggers>
                                <DataTrigger Binding="{Binding PinDot6}" TargetType="shapes:Ellipse" Value="True">
                                    <Setter Property="Fill" Value="#1565D8" />
                                </DataTrigger>
                            </shapes:Ellipse.Triggers>
                        </shapes:Ellipse>
                    </HorizontalStackLayout>

                    <Entry
                        x:Name="HiddenPinEntry"
                        HeightRequest="1"
                        IsPassword="True"
                        Keyboard="Numeric"
                        MaxLength="6"
                        Opacity="0"
                        Text="{Binding PinInput, Mode=TwoWay}"
                        TextChanged="OnPinEntryTextChanged"
                        WidthRequest="1" />

                    <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="12"
                        HorizontalOptions="Center"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="10"
                        WidthRequest="300">
                        <Button
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="1"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="1"
                            TextColor="#172033" />
                        <Button
                            Grid.Column="1"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="2"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="2"
                            TextColor="#172033" />
                        <Button
                            Grid.Column="2"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="3"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="3"
                            TextColor="#172033" />

                        <Button
                            Grid.Row="1"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="4"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="4"
                            TextColor="#172033" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="5"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="5"
                            TextColor="#172033" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="6"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="6"
                            TextColor="#172033" />

                        <Button
                            Grid.Row="2"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="7"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="7"
                            TextColor="#172033" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="8"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="8"
                            TextColor="#172033" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="2"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="9"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="9"
                            TextColor="#172033" />

                        <Button
                            Grid.Row="3"
                            BackgroundColor="#EEF2F7"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding BackspaceCommand}"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="⌫"
                            TextColor="#172033" />
                        <Button
                            Grid.Row="3"
                            Grid.Column="1"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="0"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="0"
                            TextColor="#172033" />
                    </Grid>

                    <Button
                        BackgroundColor="#1565D8"
                        Command="{Binding LoginCommand}"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        HeightRequest="54"
                        Text="Login"
                        TextColor="White" />

                    <Label
                        FontSize="13"
                        HorizontalOptions="Center"
                        IsVisible="{Binding HasError}"
                        Text="{Binding StatusMessage}"
                        TextColor="#D92D20" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
