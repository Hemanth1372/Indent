<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IndentMate.Mobile.Views.SERIndentHeaderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:IndentMate.Mobile.ViewModels"
    BackgroundColor="#F4F7FB"
    Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:SERIndentHeaderViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="20" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" Padding="0,0,0,18">
            <Button
                BackgroundColor="Transparent"
                Clicked="OnBackClicked"
                FontSize="24"
                HeightRequest="42"
                Padding="0"
                Text="&#x2039;"
                TextColor="#172033"
                WidthRequest="42" />
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="22"
                Text="SER Indent Header"
                TextColor="#172033"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14">
                <Label FontAttributes="Bold" FontSize="13" Text="Project" TextColor="#475467" />
                <Picker
                    Title="Select project"
                    BackgroundColor="White"
                    ItemDisplayBinding="{Binding ProjectId}"
                    ItemsSource="{Binding Projects}"
                    SelectedItem="{Binding SelectedProject}" />

                <Label FontAttributes="Bold" FontSize="13" Text="Service / Rental Order" TextColor="#475467" />
                <Picker
                    Title="Select order"
                    BackgroundColor="White"
                    ItemDisplayBinding="{Binding DisplayName}"
                    ItemsSource="{Binding Orders}"
                    SelectedItem="{Binding SelectedOrder}" />

                <Label FontAttributes="Bold" FontSize="13" Text="Equipment" TextColor="#475467" />
                <Border
                    Padding="12"
                    BackgroundColor="#EEF2F7"
                    Stroke="#D6DEE9"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">
                    <Label Text="{Binding Equipment}" TextColor="#172033" />
                </Border>

                <Label FontAttributes="Bold" FontSize="13" Text="Indent Type" TextColor="#475467" />
                <Picker
                    Title="Issue / Issue Return"
                    BackgroundColor="White"
                    ItemsSource="{Binding IndentTypes}"
                    SelectedItem="{Binding SelectedIndentType}" />

                <Button
                    Margin="0,8,0,0"
                    BackgroundColor="#1565D8"
                    Command="{Binding CreateRequestCommand}"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    Text="Create Request"
                    TextColor="White" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
