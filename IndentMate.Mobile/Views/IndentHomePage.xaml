<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IndentMate.Mobile.Views.IndentHomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:IndentMate.Mobile.ViewModels"
    BackgroundColor="#F4F7FB"
    Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:IndentHomeViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="20" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,18">
            <Label
                FontAttributes="Bold"
                FontSize="24"
                Text="Indent Home"
                TextColor="#172033"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                BackgroundColor="Transparent"
                Command="{Binding LogoutCommand}"
                FontSize="22"
                HeightRequest="44"
                Padding="0"
                Text="&#x23FB;"
                TextColor="#172033"
                WidthRequest="44" />
        </Grid>

        <Grid Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout Padding="0,0,0,86" Spacing="18">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <Border Grid.Row="0" Grid.Column="0" Padding="16" BackgroundColor="#1565D8" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="8">
                                <Label FontSize="30" FontAttributes="Bold" Text="{Binding PendingApprovalCount}" TextColor="White" />
                                <Label FontSize="13" Text="Pending for Approval" TextColor="White" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Padding="16" BackgroundColor="#102A43" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="8">
                                <Label FontSize="30" FontAttributes="Bold" Text="{Binding IndentsRaisedCount}" TextColor="White" />
                                <Label FontSize="13" Text="Indents Raised" TextColor="White" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Padding="16" BackgroundColor="#D92D20" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="8">
                                <Label FontSize="30" FontAttributes="Bold" Text="{Binding RejectedIndentsCount}" TextColor="White" />
                                <Label FontSize="13" Text="Rejected Indents" TextColor="White" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="16" BackgroundColor="#6B7280" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout Spacing="8">
                                <Label FontSize="30" FontAttributes="Bold" Text="{Binding CreatedStatusCount}" TextColor="White" />
                                <Label FontSize="13" Text="Created Status" TextColor="White" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Recent Requests"
                        TextColor="#172033" />

                    <CollectionView ItemsSource="{Binding RecentIndents}" EmptyView="No recent requests.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentIndentViewModel">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="14"
                                    BackgroundColor="White"
                                    Stroke="#E5EAF2"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IndentHomeViewModel}}, Path=OpenIndentCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="4">
                                            <Label FontAttributes="Bold" FontSize="15" Text="{Binding RequestNo}" TextColor="#172033" />
                                            <Label FontSize="12" Text="{Binding DateText}" TextColor="#8A94A6" />
                                        </VerticalStackLayout>

                                        <Border
                                            Grid.Column="1"
                                            Padding="10,5"
                                            BackgroundColor="{Binding StatusColor}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center">
                                            <Label FontAttributes="Bold" FontSize="11" Text="{Binding Status}" TextColor="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>

            <Button
                BackgroundColor="#1565D8"
                Command="{Binding NewIndentCommand}"
                CornerRadius="28"
                FontAttributes="Bold"
                FontSize="28"
                HeightRequest="56"
                HorizontalOptions="End"
                Text="+"
                TextColor="White"
                VerticalOptions="End"
                WidthRequest="56" />
        </Grid>
    </Grid>
</ContentPage>
