<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IndentMate.Mobile.Views.SERIndentHeaderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:IndentMate.Mobile.Controls"
    xmlns:glyphs="clr-namespace:IndentMate.Mobile.Resources"
    xmlns:vm="clr-namespace:IndentMate.Mobile.ViewModels"
    BackgroundColor="#F4F7FB"
    Shell.NavBarIsVisible="False"
    x:DataType="vm:SERIndentHeaderViewModel">

    <ContentPage.BindingContext>
        <vm:SERIndentHeaderViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">

        <!-- ── Blue Header ──────────────────────────────────────────────────── -->
        <Grid BackgroundColor="#0E2A5C" RowDefinitions="Auto,Auto">

            <!-- Title row: back button | centred title | spacer -->
            <Grid ColumnDefinitions="44,*,44" Padding="18,44,18,16" VerticalOptions="Center">
                <Border
                    BackgroundColor="#33FFFFFF"
                    HeightRequest="40"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Border.GestureRecognizers>
                    <controls:IconLabel
                        Glyph="{x:Static glyphs:IconGlyphs.Back}"
                        IconColor="White"
                        IconSize="20"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalOptions="Center"
                    Text="Indent Creation"
                    TextColor="White"
                    VerticalOptions="Center" />

                <BoxView Grid.Column="2" Color="Transparent" />
            </Grid>

            <!-- User info strip (full-width) -->
            <Border
                Grid.Row="1"
                BackgroundColor="#162348"
                Padding="18,13"
                StrokeThickness="0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border
                        BackgroundColor="#2A3B70"
                        HeightRequest="36"
                        Stroke="#50608E"
                        StrokeShape="Ellipse"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="36">
                        <controls:IconLabel Glyph="{x:Static glyphs:IconGlyphs.Person}" IconSize="20" IconColor="White" />
                    </Border>
                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="14"
                        LineBreakMode="TailTruncation"
                        Text="{Binding UserInfo}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ── Scrollable content ──────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                HorizontalOptions="Fill"
                MaximumWidthRequest="540"
                Padding="22,22,22,32"
                Spacing="18">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFormTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <!-- ── Form card ────────────────────────────────────────────── -->
                <Border
                    BackgroundColor="White"
                    Padding="20"
                    Stroke="#E3EAF3"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow Brush="#22000000" Offset="0,3" Opacity="0.12" Radius="12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <!-- Card title with wrench icon -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border
                                BackgroundColor="#FFF8E7"
                                HeightRequest="36"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="36">
                                <controls:IconLabel
                                    Glyph="{x:Static glyphs:IconGlyphs.Spares}"
                                    IconSize="18"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                            </Border>
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Header Details"
                                TextColor="#172033"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView BackgroundColor="#EFF2F7" HeightRequest="1" />

                        <!-- Project -->
                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" FontSize="13" Text="Project *" TextColor="#475467" />
                            <controls:DropdownField
                                DisplayMemberPath="DisplayName"
                                HorizontalOptions="Fill"
                                ItemsSource="{Binding Projects}"
                                Placeholder="Select Project"
                                SelectedItem="{Binding SelectedProject}" />
                        </VerticalStackLayout>

                        <!-- Service / Rental Order -->
                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" FontSize="13" Text="Service / Rental Order *" TextColor="#475467" />
                            <controls:DropdownField
                                DisplayMemberPath="DisplayName"
                                HasMore="{Binding HasMoreOrders}"
                                HorizontalOptions="Fill"
                                IsLoading="{Binding IsOrderSearchLoading}"
                                ItemsSource="{Binding Orders}"
                                LoadMoreCommand="{Binding LoadMoreOrdersCommand}"
                                Placeholder="Select Order"
                                SearchCommand="{Binding SearchOrdersCommand}"
                                SelectedItem="{Binding SelectedOrder}" />
                        </VerticalStackLayout>

                        <!-- Equipment (Auto-filled, read-only) -->
                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" FontSize="13" TextColor="#475467">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span FontAttributes="Bold" FontSize="13" Text="Equipment " TextColor="#475467" />
                                        <Span FontSize="12" Text="(Auto-filled)" TextColor="#94A3B8" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Border
                                BackgroundColor="#F1F5F9"
                                HeightRequest="54"
                                Padding="16,0"
                                Stroke="#D6DEE9"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        FontSize="15"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Equipment}"
                                        TextColor="#475467"
                                        VerticalOptions="Center" />
                                    <controls:IconLabel
                                        Grid.Column="1"
                                        Glyph="{x:Static glyphs:IconGlyphs.Locked}"
                                        IconSize="14"
                                        IconColor="#94A3B8"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Type of Indent -->
                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" FontSize="13" Text="Type of Indent *" TextColor="#475467" />
                            <controls:DropdownField
                                HorizontalOptions="Fill"
                                ItemsSource="{Binding IndentTypes}"
                                Placeholder="Issue / Issue Return"
                                SelectedItem="{Binding SelectedIndentType}" />
                        </VerticalStackLayout>

                        <!-- Validation error -->
                        <Label
                            FontSize="13"
                            IsVisible="{Binding HasError}"
                            Text="{Binding StatusMessage}"
                            TextColor="#D92D20" />

                    </VerticalStackLayout>
                </Border>

                <!-- ── Create Request button ────────────────────────────────── -->
                <Border
                    BackgroundColor="#0E2A5C"
                    HeightRequest="56"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="#441565D8" Offset="0,4" Opacity="0.35" Radius="10" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CreateRequestCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" VerticalOptions="Center">
                        <Border
                            BackgroundColor="#33FFFFFF"
                            HeightRequest="30"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="30">
                            <!-- ALIGNMENT RISK: 📄 document emoji — no matching IconGlyphs constant; left as-is -->
                            <Label
                                FontSize="14"
                                HorizontalOptions="Center"
                                Text="📄"
                                VerticalOptions="Center" />
                        </Border>
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="Create Request"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
