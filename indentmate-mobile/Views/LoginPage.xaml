<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IndentMate.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:IndentMate.Mobile.Controls"
    xmlns:glyphs="clr-namespace:IndentMate.Mobile.Resources"
    xmlns:vm="clr-namespace:IndentMate.Mobile.ViewModels"
    BackgroundColor="#F4F7FB"
    Shell.NavBarIsVisible="False"
    x:DataType="vm:LoginViewModel">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <Grid x:Name="RootLayout" Padding="24,18,24,28" RowDefinitions="Auto,*">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnUserInteraction" />
        </Grid.GestureRecognizers>

        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Start">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Image
                    Aspect="AspectFit"
                    HeightRequest="40"
                    Source="ncc_logo.png"
                    VerticalOptions="Center"
                    WidthRequest="86" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="IndentMate"
                    TextColor="#172033"
                    VerticalOptions="Center" />
            </Grid>

            <Button
                Grid.Column="2"
                Padding="0"
                BackgroundColor="Transparent"
                Command="{Binding GoToSetupCommand}"
                FontSize="24"
                HeightRequest="44"
                Text="&#x2699;"
                TextColor="#172033"
                WidthRequest="44" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="*,Auto,*">
            <VerticalStackLayout
                Grid.Row="1"
                HorizontalOptions="Center"
                MaximumWidthRequest="420"
                Spacing="14"
                WidthRequest="420">

                <Border
                    BackgroundColor="#092759"
                    HeightRequest="92"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0"
                    WidthRequest="92">
                    <Label
                        FontAttributes="Bold"
                        FontSize="32"
                        HorizontalOptions="Center"
                        Text="{Binding SelectedInitials}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        LineBreakMode="TailTruncation"
                        Text="{Binding EngineerName}"
                        TextColor="#172033" />
                    <Label
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="{Binding EngineerId, StringFormat='Employee ID: {0}'}"
                        TextColor="#8A94A6" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="ENTER PIN"
                        TextColor="#8A94A6" />

                    <Grid ColumnDefinitions="*,60" ColumnSpacing="14" HorizontalOptions="Center" WidthRequest="360">
                        <Border
                            BackgroundColor="White"
                            HeightRequest="62"
                            Padding="22,0"
                            Stroke="#E5EAF2"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPinDisplayTapped" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Label
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding ShowPinPlaceholder}"
                                    Text="Enter your 6 digit pin"
                                    TextColor="#98A2B3"
                                    VerticalOptions="Center" />
                                <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="6">
                                    <Label FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding PinChar1}" TextColor="#092759" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding PinChar2}" TextColor="#092759" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="2" FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding PinChar3}" TextColor="#092759" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="3" FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding PinChar4}" TextColor="#092759" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="4" FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding PinChar5}" TextColor="#092759" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="5" FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding PinChar6}" TextColor="#092759" VerticalTextAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="White"
                            HeightRequest="62"
                            Stroke="#E5EAF2"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1"
                            WidthRequest="60">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePinVisibilityCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <controls:IconLabel Glyph="{x:Static glyphs:IconGlyphs.Eye}" IconSize="24" IconColor="#092759" IsVisible="{Binding IsPinVisible}" />
                                <controls:IconLabel Glyph="{x:Static glyphs:IconGlyphs.EyeOff}" IconSize="26" IconColor="#092759" IsVisible="{Binding IsPinHidden}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Entry
                        x:Name="HiddenPinEntry"
                        HeightRequest="1"
                        IsEnabled="{Binding IsPinEntryEnabled}"
                        IsPassword="True"
                        Keyboard="Numeric"
                        MaxLength="6"
                        Opacity="0"
                        Text="{Binding PinInput, Mode=TwoWay}"
                        TextChanged="OnPinEntryTextChanged"
                        WidthRequest="1" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        HorizontalOptions="Center"
                        IsVisible="{Binding HasError}"
                        Text="{Binding StatusMessage}"
                        TextColor="#D92D20" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="Forgot password?"
                        TextColor="#092759">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ForgotPinCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Button
                        BackgroundColor="#092759"
                        Command="{Binding LoginCommand}"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        HeightRequest="54"
                        IsEnabled="{Binding IsPinEntryEnabled}"
                        Text="Login"
                        TextColor="White" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
