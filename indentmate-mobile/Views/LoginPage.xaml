<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IndentMate.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:IndentMate.Mobile.Controls"
    xmlns:glyphs="clr-namespace:IndentMate.Mobile.Resources"
    xmlns:vm="clr-namespace:IndentMate.Mobile.ViewModels"
    BackgroundColor="#F4F7FB"
    Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <Grid x:Name="RootLayout" Padding="24,18,24,28" RowDefinitions="Auto,*">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnUserInteraction" />
        </Grid.GestureRecognizers>

        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Start">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Image
                    Aspect="AspectFit"
                    HeightRequest="40"
                    Source="ncc_logo.png"
                    VerticalOptions="Center"
                    WidthRequest="86" />
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="IndentMate"
                    TextColor="#172033"
                    VerticalOptions="Center" />
            </Grid>

            <Button
                Grid.Column="2"
                Padding="0"
                BackgroundColor="Transparent"
                Command="{Binding GoToSetupCommand}"
                FontSize="24"
                HeightRequest="44"
                Text="&#x2699;"
                TextColor="#172033"
                WidthRequest="44" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="*,Auto,*">
            <VerticalStackLayout
                Grid.Row="1"
                HorizontalOptions="Center"
                MaximumWidthRequest="420"
                Spacing="14"
                WidthRequest="420">

                <Border
                    BackgroundColor="#092759"
                    HeightRequest="92"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 28"
                    StrokeThickness="0"
                    WidthRequest="92">
                    <Label
                        FontAttributes="Bold"
                        FontSize="32"
                        HorizontalOptions="Center"
                        Text="{Binding SelectedInitials}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="3">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        LineBreakMode="TailTruncation"
                        Text="{Binding EngineerName}"
                        TextColor="#172033" />
                    <Label
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="{Binding EngineerId, StringFormat='Employee ID: {0}'}"
                        TextColor="#8A94A6" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="ENTER PIN"
                        TextColor="#8A94A6" />

                    <Grid ColumnDefinitions="*,60" ColumnSpacing="14" HorizontalOptions="Center" WidthRequest="360">
                        <Border
                            BackgroundColor="White"
                            HeightRequest="62"
                            Padding="22,0"
                            Stroke="#E5EAF2"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1">
                            <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="6">
                                <Label FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding PinChar1}" TextColor="#092759" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding PinChar2}" TextColor="#092759" VerticalTextAlignment="Center" />
                                <Label Grid.Column="2" FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding PinChar3}" TextColor="#092759" VerticalTextAlignment="Center" />
                                <Label Grid.Column="3" FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding PinChar4}" TextColor="#092759" VerticalTextAlignment="Center" />
                                <Label Grid.Column="4" FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding PinChar5}" TextColor="#092759" VerticalTextAlignment="Center" />
                                <Label Grid.Column="5" FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center" Text="{Binding PinChar6}" TextColor="#092759" VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="White"
                            HeightRequest="62"
                            Stroke="#E5EAF2"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="1"
                            WidthRequest="60">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePinVisibilityCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <controls:IconLabel Glyph="{x:Static glyphs:IconGlyphs.Eye}" IconSize="24" IconColor="#092759" IsVisible="{Binding IsPinVisible}" />
                                <controls:IconLabel Glyph="{x:Static glyphs:IconGlyphs.EyeOff}" IconSize="26" IconColor="#092759" IsVisible="{Binding IsPinHidden}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Entry
                        x:Name="HiddenPinEntry"
                        HeightRequest="1"
                        IsEnabled="{Binding IsPinEntryEnabled}"
                        IsPassword="True"
                        Keyboard="Numeric"
                        MaxLength="6"
                        Opacity="0"
                        Text="{Binding PinInput, Mode=TwoWay}"
                        TextChanged="OnPinEntryTextChanged"
                        WidthRequest="1" />

                    <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="16"
                        HorizontalOptions="Center"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="10"
                        WidthRequest="360">
                        <Button BackgroundColor="White" BorderColor="#E5EAF2" BorderWidth="1" Command="{Binding AddDigitCommand}" CommandParameter="1" CornerRadius="16" FontAttributes="Bold" FontSize="26" HeightRequest="62" IsEnabled="{Binding IsPinEntryEnabled}" Text="1" TextColor="#172033" />
                        <Button Grid.Column="1" BackgroundColor="White" BorderColor="#E5EAF2" BorderWidth="1" Command="{Binding AddDigitCommand}" CommandParameter="2" CornerRadius="16" FontAttributes="Bold" FontSize="26" HeightRequest="62" IsEnabled="{Binding IsPinEntryEnabled}" Text="2" TextColor="#172033" />
                        <Button Grid.Column="2" BackgroundColor="White" BorderColor="#E5EAF2" BorderWidth="1" Command="{Binding AddDigitCommand}" CommandParameter="3" CornerRadius="16" FontAttributes="Bold" FontSize="26" HeightRequest="62" IsEnabled="{Binding IsPinEntryEnabled}" Text="3" TextColor="#172033" />

                        <Button Grid.Row="1" BackgroundColor="White" BorderColor="#E5EAF2" BorderWidth="1" Command="{Binding AddDigitCommand}" CommandParameter="4" CornerRadius="16" FontAttributes="Bold" FontSize="26" HeightRequest="62" IsEnabled="{Binding IsPinEntryEnabled}" Text="4" TextColor="#172033" />
                        <Button Grid.Row="1" Grid.Column="1" BackgroundColor="White" BorderColor="#E5EAF2" BorderWidth="1" Command="{Binding AddDigitCommand}" CommandParameter="5" CornerRadius="16" FontAttributes="Bold" FontSize="26" HeightRequest="62" IsEnabled="{Binding IsPinEntryEnabled}" Text="5" TextColor="#172033" />
                        <Button Grid.Row="1" Grid.Column="2" BackgroundColor="White" BorderColor="#E5EAF2" BorderWidth="1" Command="{Binding AddDigitCommand}" CommandParameter="6" CornerRadius="16" FontAttributes="Bold" FontSize="26" HeightRequest="62" IsEnabled="{Binding IsPinEntryEnabled}" Text="6" TextColor="#172033" />

                        <Button Grid.Row="2" BackgroundColor="White" BorderColor="#E5EAF2" BorderWidth="1" Command="{Binding AddDigitCommand}" CommandParameter="7" CornerRadius="16" FontAttributes="Bold" FontSize="26" HeightRequest="62" IsEnabled="{Binding IsPinEntryEnabled}" Text="7" TextColor="#172033" />
                        <Button Grid.Row="2" Grid.Column="1" BackgroundColor="White" BorderColor="#E5EAF2" BorderWidth="1" Command="{Binding AddDigitCommand}" CommandParameter="8" CornerRadius="16" FontAttributes="Bold" FontSize="26" HeightRequest="62" IsEnabled="{Binding IsPinEntryEnabled}" Text="8" TextColor="#172033" />
                        <Button Grid.Row="2" Grid.Column="2" BackgroundColor="White" BorderColor="#E5EAF2" BorderWidth="1" Command="{Binding AddDigitCommand}" CommandParameter="9" CornerRadius="16" FontAttributes="Bold" FontSize="26" HeightRequest="62" IsEnabled="{Binding IsPinEntryEnabled}" Text="9" TextColor="#172033" />

                        <Button Grid.Row="3" BackgroundColor="#EAF0F6" BorderColor="#EAF0F6" BorderWidth="1" Command="{Binding BackspaceCommand}" CornerRadius="16" FontAttributes="Bold" FontSize="20" HeightRequest="62" IsEnabled="{Binding IsPinEntryEnabled}" Text="&#x232B;" TextColor="#667085" />
                        <Button Grid.Row="3" Grid.Column="1" BackgroundColor="White" BorderColor="#E5EAF2" BorderWidth="1" Command="{Binding AddDigitCommand}" CommandParameter="0" CornerRadius="16" FontAttributes="Bold" FontSize="26" HeightRequest="62" IsEnabled="{Binding IsPinEntryEnabled}" Text="0" TextColor="#172033" />
                        <Button Grid.Row="3" Grid.Column="2" BackgroundColor="#EAF0F6" BorderColor="#EAF0F6" BorderWidth="1" Command="{Binding ClearPinCommand}" CornerRadius="16" FontAttributes="Bold" FontSize="13" HeightRequest="62" IsEnabled="{Binding IsPinEntryEnabled}" Text="CLEAR" TextColor="#667085" />
                    </Grid>

                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        HorizontalOptions="Center"
                        IsVisible="{Binding HasError}"
                        Text="{Binding StatusMessage}"
                        TextColor="#D92D20" />

                    <Button
                        BackgroundColor="#092759"
                        Command="{Binding LoginCommand}"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        HeightRequest="54"
                        IsEnabled="{Binding IsPinEntryEnabled}"
                        Text="Login"
                        TextColor="White" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
