<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IndentMate.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:IndentMate.Mobile.ViewModels"
    BackgroundColor="#F4F7FB"
    Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>

    <Grid x:Name="RootLayout" Padding="24,18,24,28" RowDefinitions="Auto,*">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnUserInteraction" />
        </Grid.GestureRecognizers>

        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Start">
            <Grid ColumnDefinitions="40,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Border
                    HeightRequest="40"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    WidthRequest="40"
                    BackgroundColor="#1565D8">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="IM"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="IndentMate"
                    TextColor="#172033"
                    VerticalOptions="Center" />
            </Grid>

            <Button
                Grid.Column="2"
                Padding="0"
                BackgroundColor="Transparent"
                Command="{Binding GoToSetupCommand}"
                FontSize="24"
                HeightRequest="44"
                Text="&#x2699;"
                TextColor="#172033"
                WidthRequest="44" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="24">
            <Border
                BackgroundColor="White"
                IsVisible="{Binding HasRecentEngineers}"
                Padding="18"
                Stroke="#E5EAF2"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1"
                VerticalOptions="Fill"
                WidthRequest="280">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="RECENT LOGINS"
                        TextColor="#6B7280" />

                    <CollectionView
                        Grid.Row="1"
                        ItemsSource="{Binding RecentEngineers}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#E5EAF2"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectEngineerCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="12">
                                        <Border
                                            BackgroundColor="#EBF3FF"
                                            HeightRequest="42"
                                            StrokeShape="RoundRectangle 21"
                                            StrokeThickness="0"
                                            WidthRequest="42">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                HorizontalOptions="Center"
                                                Text="IM"
                                                TextColor="#1565D8"
                                                VerticalOptions="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding Name}"
                                                TextColor="#172033" />
                                            <Label
                                                FontSize="12"
                                                Text="{Binding EngineerId, StringFormat='Employee ID: {0}'}"
                                                TextColor="#7B8794" />
                                        </VerticalStackLayout>

                                        <Button
                                            Grid.Column="2"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveEngineerCommand}"
                                            CommandParameter="{Binding .}"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            HeightRequest="24"
                                            Text="X"
                                            TextColor="#A0AEC0"
                                            VerticalOptions="Center"
                                            WidthRequest="24" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button
                        Grid.Row="2"
                        BackgroundColor="White"
                        BorderColor="#D6DEE9"
                        BorderWidth="1"
                        Command="{Binding LoginAsDifferentUserCommand}"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        Text="+  Login as different user"
                        TextColor="#1565D8" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="*,Auto,*">
                <VerticalStackLayout Grid.Row="1" Spacing="20">
                <Border
                    BackgroundColor="#1565D8"
                    HeightRequest="112"
                    HorizontalOptions="Center"
                    IsVisible="{Binding HasSelectedEngineer}"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="0"
                    WidthRequest="112">
                    <Label
                        FontAttributes="Bold"
                        FontSize="36"
                        HorizontalOptions="Center"
                        Text="{Binding SelectedInitials}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Spacing="3" HorizontalOptions="Center" IsVisible="{Binding HasSelectedEngineer}">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="Center"
                        Text="{Binding EngineerName}"
                        TextColor="#172033" />
                    <Label
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="{Binding EngineerId, StringFormat='Employee ID: {0}'}"
                        TextColor="#8A94A6" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding ShowManualEngineerEntry}"
                    MaximumWidthRequest="420"
                    Spacing="12"
                    WidthRequest="420">
                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        HorizontalOptions="Center"
                        Text="Welcome to IndentMate"
                        TextColor="#172033" />
                    <Entry
                        BackgroundColor="White"
                        ClearButtonVisibility="WhileEditing"
                        HorizontalTextAlignment="Center"
                        Keyboard="Text"
                        Placeholder="Enter Employee ID (e.g. 10075)"
                        Text="{Binding ManualEngineerId, Mode=TwoWay}"
                        TextColor="#172033" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="16" Margin="0,12,0,0">
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        HorizontalOptions="Center"
                        Text="ENTER PIN"
                        TextColor="#8A94A6" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="14">
                        <shapes:Ellipse Fill="#CED6E0" HeightRequest="16" WidthRequest="16">
                            <shapes:Ellipse.Triggers>
                                <DataTrigger Binding="{Binding PinDot1}" TargetType="shapes:Ellipse" Value="True">
                                    <Setter Property="Fill" Value="#1565D8" />
                                </DataTrigger>
                            </shapes:Ellipse.Triggers>
                        </shapes:Ellipse>
                        <shapes:Ellipse Fill="#CED6E0" HeightRequest="16" WidthRequest="16">
                            <shapes:Ellipse.Triggers>
                                <DataTrigger Binding="{Binding PinDot2}" TargetType="shapes:Ellipse" Value="True">
                                    <Setter Property="Fill" Value="#1565D8" />
                                </DataTrigger>
                            </shapes:Ellipse.Triggers>
                        </shapes:Ellipse>
                        <shapes:Ellipse Fill="#CED6E0" HeightRequest="16" WidthRequest="16">
                            <shapes:Ellipse.Triggers>
                                <DataTrigger Binding="{Binding PinDot3}" TargetType="shapes:Ellipse" Value="True">
                                    <Setter Property="Fill" Value="#1565D8" />
                                </DataTrigger>
                            </shapes:Ellipse.Triggers>
                        </shapes:Ellipse>
                        <shapes:Ellipse Fill="#CED6E0" HeightRequest="16" WidthRequest="16">
                            <shapes:Ellipse.Triggers>
                                <DataTrigger Binding="{Binding PinDot4}" TargetType="shapes:Ellipse" Value="True">
                                    <Setter Property="Fill" Value="#1565D8" />
                                </DataTrigger>
                            </shapes:Ellipse.Triggers>
                        </shapes:Ellipse>
                        <shapes:Ellipse Fill="#CED6E0" HeightRequest="16" WidthRequest="16">
                            <shapes:Ellipse.Triggers>
                                <DataTrigger Binding="{Binding PinDot5}" TargetType="shapes:Ellipse" Value="True">
                                    <Setter Property="Fill" Value="#1565D8" />
                                </DataTrigger>
                            </shapes:Ellipse.Triggers>
                        </shapes:Ellipse>
                        <shapes:Ellipse Fill="#CED6E0" HeightRequest="16" WidthRequest="16">
                            <shapes:Ellipse.Triggers>
                                <DataTrigger Binding="{Binding PinDot6}" TargetType="shapes:Ellipse" Value="True">
                                    <Setter Property="Fill" Value="#1565D8" />
                                </DataTrigger>
                            </shapes:Ellipse.Triggers>
                        </shapes:Ellipse>
                    </HorizontalStackLayout>

                    <Entry
                        x:Name="HiddenPinEntry"
                        HeightRequest="1"
                        IsPassword="True"
                        Keyboard="Numeric"
                        MaxLength="6"
                        Opacity="0"
                        Text="{Binding PinInput, Mode=TwoWay}"
                        TextChanged="OnPinEntryTextChanged"
                        WidthRequest="1" />

                    <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="12"
                        HorizontalOptions="Center"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="10"
                        WidthRequest="300">
                        <Button
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="1"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="1"
                            TextColor="#172033" />
                        <Button
                            Grid.Column="1"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="2"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="2"
                            TextColor="#172033" />
                        <Button
                            Grid.Column="2"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="3"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="3"
                            TextColor="#172033" />

                        <Button
                            Grid.Row="1"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="4"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="4"
                            TextColor="#172033" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="5"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="5"
                            TextColor="#172033" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="6"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="6"
                            TextColor="#172033" />

                        <Button
                            Grid.Row="2"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="7"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="7"
                            TextColor="#172033" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="8"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="8"
                            TextColor="#172033" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="2"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="9"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="9"
                            TextColor="#172033" />

                        <Button
                            Grid.Row="3"
                            BackgroundColor="#EEF2F7"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding BackspaceCommand}"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="&#x232B;"
                            TextColor="#172033" />
                        <Button
                            Grid.Row="3"
                            Grid.Column="1"
                            BackgroundColor="White"
                            BorderColor="#D6DEE9"
                            BorderWidth="1"
                            Command="{Binding AddDigitCommand}"
                            CommandParameter="0"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HeightRequest="48"
                            Text="0"
                            TextColor="#172033" />
                    </Grid>

                    <Button
                        BackgroundColor="Transparent"
                        Command="{Binding ForgotPinCommand}"
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="Forgot PIN?"
                        TextColor="#6B7280" />

                    <Button
                        BackgroundColor="#1565D8"
                        Command="{Binding LoginCommand}"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        HeightRequest="54"
                        Text="Login"
                        TextColor="White" />

                    <Label
                        FontSize="13"
                        HorizontalOptions="Center"
                        IsVisible="{Binding HasError}"
                        Text="{Binding StatusMessage}"
                        TextColor="#D92D20" />
                </VerticalStackLayout>
            </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
