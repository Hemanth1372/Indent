<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IndentMate.Mobile.Views.IndentHomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:IndentMate.Mobile.Controls"
    xmlns:glyphs="clr-namespace:IndentMate.Mobile.Resources"
    xmlns:vm="clr-namespace:IndentMate.Mobile.ViewModels"
    BackgroundColor="#F4F7FB"
    Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:IndentHomeViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">

        <Grid BackgroundColor="#F4F7FB" Padding="14,12,14,0">
            <Border
                BackgroundColor="#0E2A5C"
                Padding="0"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0">
                <VerticalStackLayout Spacing="0">

                    <Grid ColumnDefinitions="40,*,40,40,40" ColumnSpacing="12" Padding="16,14,16,0">

                        <Border
                            BackgroundColor="#1AFFFFFF"
                            HeightRequest="40"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="40">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackCommand}" />
                            </Border.GestureRecognizers>
                            <controls:IconLabel
                                Glyph="{x:Static glyphs:IconGlyphs.ArrowBack}"
                                IconSize="20"
                                IconColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="19"
                            LineBreakMode="TailTruncation"
                            Text="{Binding DashboardTitle}"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Border
                            Grid.Column="2"
                            BackgroundColor="#1AFFFFFF"
                            HeightRequest="40"
                            HorizontalOptions="End"
                            StrokeShape="Ellipse"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="40">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleNotificationsCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <controls:IconLabel
                                    Glyph="{x:Static glyphs:IconGlyphs.Notifications}"
                                    IconSize="18"
                                    IconColor="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
                                <Border
                                    BackgroundColor="#EF4444"
                                    HeightRequest="16"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding HasUnreadNotifications}"
                                    StrokeShape="Ellipse"
                                    StrokeThickness="0"
                                    VerticalOptions="Start"
                                    WidthRequest="16">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="9"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding UnreadNotificationCount}"
                                        TextColor="White"
                                        VerticalTextAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="3"
                            BackgroundColor="#F7931E"
                            HeightRequest="40"
                            HorizontalOptions="End"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="40">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NewIndentCommand}" />
                            </Border.GestureRecognizers>
                            <controls:IconLabel
                                Glyph="{x:Static glyphs:IconGlyphs.Add}"
                                IconSize="26"
                                IconColor="#0E2A5C"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Border
                            Grid.Column="4"
                            BackgroundColor="#1AFFFFFF"
                            HeightRequest="40"
                            HorizontalOptions="End"
                            StrokeShape="Ellipse"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="40">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleAccountMenuCommand}" />
                            </Border.GestureRecognizers>
                            <controls:IconLabel
                                Glyph="{x:Static glyphs:IconGlyphs.MoreVert}"
                                IconSize="22"
                                IconColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <BoxView
                        BackgroundColor="#26FFFFFF"
                        HeightRequest="1"
                        Margin="16,14" />

                    <Grid ColumnDefinitions="44,*,280" ColumnSpacing="12" Padding="16,0,16,16">
                        <Border
                            HeightRequest="44"
                            Padding="2"
                            StrokeShape="Ellipse"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="44">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#522E91" Offset="0.0" />
                                    <GradientStop Color="#EC008C" Offset="0.35" />
                                    <GradientStop Color="#F7931E" Offset="0.7" />
                                    <GradientStop Color="#FDB913" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border
                                BackgroundColor="#0E2A5C"
                                StrokeShape="Ellipse"
                                StrokeThickness="0">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                    Text="{Binding UserInitials}"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                            </Border>
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3"
                            VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                LineBreakMode="TailTruncation"
                                Text="{Binding UserName}"
                                TextColor="White" />
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                <Label
                                    FontSize="12"
                                    Text="{Binding UserId, StringFormat='ID {0}'}"
                                    TextColor="#D9FFFFFF"
                                    VerticalOptions="Center" />
                                <Border
                                    Grid.Column="1"
                                    Padding="7,1"
                                    Stroke="#8CFDB913"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="1"
                                    VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="11"
                                        Text="{Binding UserEntity}"
                                        TextColor="#FDB913" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <controls:DropdownField
                            Grid.Column="2"
                            DisplayMemberPath="Label"
                            HorizontalOptions="End"
                            ItemsSource="{Binding ProjectFilters}"
                            Placeholder="All Projects"
                            PopupWidthRequest="520"
                            SelectedItem="{Binding SelectedProjectFilter}"
                            TriggerBackgroundColor="#294A7C"
                            TriggerBorderColor="#6680AD"
                            TriggerFontAttributes="Bold"
                            TriggerIconColor="#E7EEFA"
                            TriggerOpenBorderColor="#A9BCE0"
                            TriggerOpenIconColor="White"
                            TriggerPlaceholderColor="#E7EEFA"
                            TriggerTextColor="White"
                            VerticalOptions="Center"
                            WidthRequest="280" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Grid
            BackgroundColor="#1D2B58"
            IsVisible="False"
            RowDefinitions="Auto,Auto">

            <!-- Title + action icon buttons -->
            <Grid ColumnDefinitions="44,*,Auto,Auto" ColumnSpacing="10" Padding="18,40,18,16">

                <!-- Back button -->
                <Border
                    BackgroundColor="#33FFFFFF"
                    HeightRequest="44"
                    StrokeShape="RoundRectangle 11"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>
                    <controls:IconLabel
                        Glyph="{x:Static glyphs:IconGlyphs.Back}"
                        IconColor="White"
                        IconSize="20"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="{Binding DashboardTitle}"
                    TextColor="White"
                    VerticalOptions="Center" />

                <!-- Refresh icon button (sky-blue circle + sync arrows) -->
                <Border
                    Grid.Column="2"
                    BackgroundColor="#2A3B70"
                    HeightRequest="44"
                    HorizontalOptions="End"
                    StrokeShape="Ellipse"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RefreshCommand}" />
                    </Border.GestureRecognizers>
                    <controls:IconLabel
                        Glyph="{x:Static glyphs:IconGlyphs.Refresh}"
                        IconSize="18"
                        IconColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <!-- New Indent icon button (white pill with blue +) -->
                <Border
                    Grid.Column="3"
                    BackgroundColor="#F7931E"
                    HeightRequest="44"
                    HorizontalOptions="End"
                    StrokeShape="RoundRectangle 11"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NewIndentCommand}" />
                    </Border.GestureRecognizers>
                    <controls:IconLabel
                        Glyph="{x:Static glyphs:IconGlyphs.Add}"
                        IconSize="28"
                        IconColor="#1D2B58"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- User info strip with avatar initials -->
            <Border
                Grid.Row="1"
                BackgroundColor="#162348"
                Padding="18,13"
                StrokeThickness="0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <!-- User avatar circle with person silhouette -->
                    <Border
                        BackgroundColor="#2A3B70"
                        HeightRequest="36"
                        Stroke="#50608E"
                        StrokeShape="Ellipse"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="36">
                        <controls:IconLabel Glyph="{x:Static glyphs:IconGlyphs.Person}" IconSize="20" IconColor="White" />
                    </Border>
                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="14"
                        LineBreakMode="TailTruncation"
                        Text="{Binding UserInfo}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ── Content ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <RefreshView
                Command="{Binding RefreshCommand}"
                RefreshColor="#F7931E">
                <ScrollView>
                <VerticalStackLayout Padding="22,22,22,32" Spacing="18">

                    <!-- 2×2 stat cards (background + accent strip changes with count) -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="12">

                        <!-- Pending for Approval (amber) -->
                        <Border
                            Grid.Row="0" Grid.Column="0"
                            BackgroundColor="{Binding PendingCardBg}"
                            Padding="0"
                            Stroke="#E5EAF2"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectSummaryCardCommand}" CommandParameter="Pending" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="5,*">
                                <BoxView BackgroundColor="{Binding PendingAccentColor}" />
                                <VerticalStackLayout Grid.Column="1" Padding="13,15,13,14" Spacing="5">
                                    <Label FontAttributes="Bold" FontSize="34" Text="{Binding PendingApprovalCount}" TextColor="{Binding PendingNumColor}" />
                                    <Label FontSize="12" LineBreakMode="WordWrap" Text="Pending for Approval" TextColor="#6B7280" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Indents Raised (blue) -->
                        <Border
                            Grid.Row="0" Grid.Column="1"
                            BackgroundColor="{Binding RaisedCardBg}"
                            Padding="0"
                            Stroke="#E5EAF2"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectSummaryCardCommand}" CommandParameter="All" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="5,*">
                                <BoxView BackgroundColor="{Binding RaisedAccentColor}" />
                                <VerticalStackLayout Grid.Column="1" Padding="13,15,13,14" Spacing="5">
                                    <Label FontAttributes="Bold" FontSize="34" Text="{Binding IndentsRaisedCount}" TextColor="{Binding RaisedNumColor}" />
                                    <Label FontSize="12" LineBreakMode="WordWrap" Text="Indents Raised" TextColor="#6B7280" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Rejected Indents (red) -->
                        <Border
                            Grid.Row="1" Grid.Column="0"
                            BackgroundColor="{Binding RejectedCardBg}"
                            Padding="0"
                            Stroke="#E5EAF2"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectSummaryCardCommand}" CommandParameter="Rejected" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="5,*">
                                <BoxView BackgroundColor="{Binding RejectedAccentColor}" />
                                <VerticalStackLayout Grid.Column="1" Padding="13,15,13,14" Spacing="5">
                                    <Label FontAttributes="Bold" FontSize="34" Text="{Binding RejectedIndentsCount}" TextColor="{Binding RejectedNumColor}" />
                                    <Label FontSize="12" LineBreakMode="WordWrap" Text="Rejected Indents" TextColor="#6B7280" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Pending Sync (orange) -->
                        <Border
                            Grid.Row="1" Grid.Column="1"
                            BackgroundColor="{Binding PendingSyncCardBg}"
                            Padding="0"
                            Stroke="#E5EAF2"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectSummaryCardCommand}" CommandParameter="Pending Sync" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="5,*">
                                <BoxView BackgroundColor="{Binding PendingSyncAccentColor}" />
                                <VerticalStackLayout Grid.Column="1" Padding="13,15,13,14" Spacing="5">
                                    <Label FontAttributes="Bold" FontSize="34" Text="{Binding PendingSyncCount}" TextColor="{Binding PendingSyncNumColor}" />
                                    <Label FontSize="12" LineBreakMode="WordWrap" Text="Pending Sync" TextColor="#6B7280" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Status filter chips -->
                    <CollectionView
                        HeightRequest="46"
                        ItemsLayout="HorizontalList"
                        ItemsSource="{Binding StatusFilters}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatusFilterViewModel">
                                <Button
                                    Margin="0,0,8,0"
                                    Padding="18,0"
                                    BackgroundColor="{Binding BackgroundColor}"
                                    BorderColor="{Binding BorderColor}"
                                    BorderWidth="1.5"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectStatusFilterCommand}"
                                    CommandParameter="{Binding Label}"
                                    CornerRadius="22"
                                    FontAttributes="Bold"
                                    HeightRequest="42"
                                    Text="{Binding Label}"
                                    TextColor="{Binding TextColor}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Section header -->
                    <Grid ColumnDefinitions="*,Auto" Padding="0,2,0,0">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="RECENT REQUESTS"
                            TextColor="#172033"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            Command="{Binding ToggleSeeAllCommand}"
                            FontAttributes="Bold"
                            FontSize="14"
                            IsVisible="{Binding HasSeeAllAction}"
                            Padding="8,0"
                            Text="{Binding SeeAllText}"
                            TextColor="#1D2B58" />
                    </Grid>

                    <!-- Recent request cards -->
                    <CollectionView EmptyView="No recent requests." ItemsSource="{Binding RecentIndents}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="16" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentIndentViewModel">
                                <Border
                                    BackgroundColor="{Binding CardBg}"
                                    Padding="0"
                                    Stroke="{Binding CardAccentColor}"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="1">
                                    <Border.Shadow>
                                        <Shadow Brush="#26000000" Offset="0,4" Opacity="0.14" Radius="12" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenIndentCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <!-- Accent strip + content -->
                                    <Grid ColumnDefinitions="6,*">
                                        <BoxView BackgroundColor="{Binding CardAccentColor}" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="0">

                                            <!-- Card header: IndentNo + status badge -->
                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                ColumnSpacing="8"
                                                Padding="14,14,14,12">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="15"
                                                    LineBreakMode="TailTruncation"
                                                    Text="{Binding IndentNo}"
                                                    TextColor="#111827"
                                                    VerticalOptions="Center" />
                                                <Border
                                                    Grid.Column="1"
                                                    BackgroundColor="{Binding StatusColor}"
                                                    Padding="10,5"
                                                    StrokeShape="RoundRectangle 10"
                                                    StrokeThickness="0"
                                                    VerticalOptions="Center">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        Text="{Binding Status}"
                                                        TextColor="{Binding StatusTextColor}" />
                                                </Border>
                                            </Grid>

                                            <!-- Divider -->
                                            <BoxView BackgroundColor="{Binding CardAccentColor}" HeightRequest="1" Opacity="0.35" />

                                            <!-- Info rows -->
                                            <VerticalStackLayout Padding="14,12,14,15" Spacing="11">

                                                <!-- Request No -->
                                                <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                                                    <controls:IconLabel
                                                        Glyph="{x:Static glyphs:IconGlyphs.Hash}"
                                                        IconSize="13"
                                                        IconColor="#4B5563"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="1"
                                                        FontAttributes="Bold"
                                                        FontSize="13"
                                                        Text="{Binding RequestNo}"
                                                        TextColor="#065F46"
                                                        VerticalOptions="Center" />
                                                </Grid>

                                                <!-- Date -->
                                                <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                                                    <controls:IconLabel
                                                        Glyph="{x:Static glyphs:IconGlyphs.Calendar}"
                                                        IconSize="14"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="1"
                                                        FontSize="13"
                                                        Text="{Binding DateText}"
                                                        TextColor="#1F2937"
                                                        VerticalOptions="Center" />
                                                </Grid>

                                                <!-- Project -->
                                                <Grid
                                                    ColumnDefinitions="22,*"
                                                    ColumnSpacing="10"
                                                    IsVisible="{Binding HasProject}">
                                                    <controls:IconLabel
                                                        Glyph="{x:Static glyphs:IconGlyphs.Location}"
                                                        IconSize="14"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="1"
                                                        FontSize="13"
                                                        LineBreakMode="TailTruncation"
                                                        Text="{Binding ProjectDisplay}"
                                                        TextColor="#1F2937"
                                                        VerticalOptions="Center" />
                                                </Grid>

                                                <!-- Warehouse -->
                                                <Grid
                                                    ColumnDefinitions="22,*"
                                                    ColumnSpacing="10"
                                                    IsVisible="{Binding HasWarehouse}">
                                                    <controls:IconLabel
                                                        Glyph="{x:Static glyphs:IconGlyphs.Warehouse}"
                                                        IconSize="14"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="1"
                                                        FontSize="13"
                                                        LineBreakMode="TailTruncation"
                                                        Text="{Binding WarehouseDisplay}"
                                                        TextColor="#1F2937"
                                                        VerticalOptions="Center" />
                                                </Grid>

                                                <!-- Indent Type -->
                                                <Grid
                                                    ColumnDefinitions="22,*"
                                                    ColumnSpacing="10"
                                                    IsVisible="{Binding HasIndentType}">
                                                    <controls:IconLabel
                                                        Glyph="{x:Static glyphs:IconGlyphs.NorthEast}"
                                                        IconSize="14"
                                                        IconColor="#4B5563"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        Grid.Column="1"
                                                        FontAttributes="Bold"
                                                        FontSize="13"
                                                        Text="{Binding IndentTypeDisplay}"
                                                        TextColor="#1F2937"
                                                        VerticalOptions="Center" />
                                                </Grid>

                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

        </Grid>

        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            BackgroundColor="#01000000"
            IsVisible="{Binding ShowNotifications}"
            ZIndex="49">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseNotificationsCommand}" />
            </Grid.GestureRecognizers>
        </Grid>

        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="0,58,28,0"
            BackgroundColor="White"
            HorizontalOptions="End"
            IsVisible="{Binding ShowNotifications}"
            Stroke="#DDE5F0"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="1"
            VerticalOptions="Start"
            WidthRequest="424"
            ZIndex="50">
            <Border.Shadow>
                <Shadow Brush="#33000000" Offset="0,8" Radius="18" Opacity="0.35" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="0">
                <Grid Padding="14,12" ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="1">
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Notifications"
                            TextColor="#172033" />
                        <Label
                            FontSize="12"
                            Text="{Binding UnreadNotificationCount, StringFormat='{0} unread'}"
                            TextColor="#64748B" />
                    </VerticalStackLayout>
                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="Mark all read"
                        TextColor="#1D4ED8"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MarkAllNotificationsReadCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
                <Label
                    Padding="14,0,14,16"
                    FontSize="13"
                    IsVisible="{Binding HasNoNotifications}"
                    Text="No notifications received."
                    TextColor="#94A3B8" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Notifications}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppNotificationViewModel">
                            <Border
                                BackgroundColor="{Binding BackgroundColor}"
                                Padding="18,12"
                                Stroke="#EEF2F7"
                                StrokeThickness="1">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenNotificationCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="4,*" ColumnSpacing="12">
                                    <BoxView
                                        BackgroundColor="{Binding AccentColor}"
                                        WidthRequest="4" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Title}"
                                            TextColor="#172033" />
                                        <Label
                                            FontSize="13"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Message}"
                                            TextColor="#667085" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding MetaText}"
                                            TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            BackgroundColor="#01000000"
            IsVisible="{Binding ShowAccountMenu}"
            ZIndex="59">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseAccountMenuCommand}" />
            </Grid.GestureRecognizers>
        </Grid>

        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="0,58,18,0"
            BackgroundColor="White"
            HorizontalOptions="End"
            IsVisible="{Binding ShowAccountMenu}"
            Stroke="#DDE5F0"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="1"
            VerticalOptions="Start"
            WidthRequest="180"
            ZIndex="60">
            <Border.Shadow>
                <Shadow Brush="#33000000" Offset="0,8" Radius="18" Opacity="0.28" />
