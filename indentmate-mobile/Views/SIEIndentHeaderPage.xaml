<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IndentMate.Mobile.Views.SIEIndentHeaderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:IndentMate.Mobile.Controls"
    xmlns:vm="clr-namespace:IndentMate.Mobile.ViewModels"
    BackgroundColor="#F4F7FB"
    Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:SIEIndentHeaderViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="24" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,0,0,18">
            <Button
                BackgroundColor="Transparent"
                Clicked="OnBackClicked"
                FontSize="24"
                HeightRequest="42"
                Padding="0"
                Text="&#x2039;"
                TextColor="#172033"
                WidthRequest="42" />
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="22"
                Text="SIE Indent Header"
                TextColor="#172033"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                HorizontalOptions="Fill"
                MaximumWidthRequest="540"
                Spacing="18">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFormTapped" />
                </VerticalStackLayout.GestureRecognizers>

                <Border
                    Padding="20"
                    BackgroundColor="White"
                    Stroke="#E3EAF3"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow
                            Brush="#22000000"
                            Offset="0,3"
                            Opacity="0.18"
                            Radius="12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Header Details"
                            TextColor="#172033" />

                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" FontSize="13" Text="Project *" TextColor="#475467" />
                            <controls:DropdownField
                                DisplayMemberPath="DisplayName"
                                HorizontalOptions="Fill"
                                ItemsSource="{Binding Projects}"
                                Placeholder="Select Project"
                                SelectedItem="{Binding SelectedProject}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" FontSize="13" Text="Indent Type *" TextColor="#475467" />
                            <controls:DropdownField
                                HorizontalOptions="Fill"
                                ItemsSource="{Binding IndentTypes}"
                                Placeholder="Select Type"
                                SelectedItem="{Binding SelectedIndentType}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" FontSize="13" Text="Warehouse *" TextColor="#475467" />
                            <Border
                                Padding="16,0"
                                BackgroundColor="#F8FAFC"
                                HeightRequest="54"
                                IsVisible="{Binding ShowAutoWarehouse}"
                                Stroke="#D6DEE9"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        FontSize="15"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding AutoWarehouseDisplay}"
                                        TextColor="#172033"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="18"
                                        Text="&#x2304;"
                                        TextColor="#667085"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <controls:DropdownField
                                DisplayMemberPath="DisplayName"
                                HorizontalOptions="Fill"
                                IsVisible="{Binding ShowWarehousePicker}"
                                ItemsSource="{Binding Warehouses}"
                                Placeholder="Select Warehouse"
                                SelectedItem="{Binding SelectedWarehouse}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" FontSize="13" Text="From Location *" TextColor="#475467" />
                            <controls:DropdownField
                                DisplayMemberPath="DisplayName"
                                HorizontalOptions="Fill"
                                ItemsSource="{Binding FromLocations}"
                                Placeholder="Select from location"
                                SelectedItem="{Binding SelectedFromLocation}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label FontAttributes="Bold" FontSize="13" Text="To (Contractor / BP)" TextColor="#475467" />
                            <controls:DropdownField
                                DisplayMemberPath="DisplayName"
                                HorizontalOptions="Fill"
                                ItemsSource="{Binding ToContractors}"
                                Placeholder="Select contractor"
                                SelectedItem="{Binding SelectedToContractor}" />
                        </VerticalStackLayout>

                        <Label
                            FontSize="13"
                            IsVisible="{Binding HasError}"
                            Text="{Binding StatusMessage}"
                            TextColor="#D92D20" />
                    </VerticalStackLayout>
                </Border>

                <Button
                    BackgroundColor="#1565D8"
                    Command="{Binding CreateRequestCommand}"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    FontSize="15"
                    HeightRequest="54"
                    Text="Create Request"
                    TextColor="White" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
