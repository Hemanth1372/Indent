<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IndentMate.Mobile.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:IndentMate.Mobile.Controls"
    xmlns:glyphs="clr-namespace:IndentMate.Mobile.Resources"
    xmlns:vm="clr-namespace:IndentMate.Mobile.ViewModels"
    Title="Initial Setup"
    BackgroundColor="#1A1A2E">

    <ContentPage.BindingContext>
        <vm:SetupViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="FillAndExpand">

            <!-- Logo / Branding -->
            <Image
                Aspect="AspectFit"
                HeightRequest="80"
                HorizontalOptions="Center"
                Margin="0,24,0,0"
                Source="ncc_logo.png"
                WidthRequest="180" />

            <!-- Title -->
            <Label Text="IndentMate" FontSize="32" FontAttributes="Bold"
                   TextColor="White" HorizontalOptions="Center" />
            <Label Text="Initial Setup" FontSize="14"
                   TextColor="#AAAACC" HorizontalOptions="Center" Margin="0,0,0,24" />

            <!-- LN Environment Picker -->
            <Label Text="LN Environment" TextColor="White" FontSize="13" FontAttributes="Bold" />
            <Picker x:Name="EnvironmentPicker"
                    Title="Select Environment"
                    TitleColor="#AAAACC"
                    TextColor="#F7931E"
                    BackgroundColor="#2A2A3E"
                    ItemDisplayBinding="{Binding DisplayName}"
                    SelectedItem="{Binding SelectedLNEnvironmentOption}"
                    ItemsSource="{Binding LNEnvironmentOptions}">
            </Picker>

            <!-- Company Code -->
            <Label Text="Company Code" TextColor="White" FontSize="13" FontAttributes="Bold" />
            <Entry Placeholder="e.g. 100"
                   Text="{Binding Company}"
                   PlaceholderColor="#666" TextColor="#F7931E"
                   BackgroundColor="#2A2A3E"
                   Keyboard="Numeric"
                   ClearButtonVisibility="WhileEditing" />

            <!-- Engineer ID -->
            <Label Text="Engineer ID" TextColor="White" FontSize="13" FontAttributes="Bold" />
            <Entry Placeholder="Your LN Engineer ID"
                   Text="{Binding EngineerId}"
                   PlaceholderColor="#666" TextColor="#F7931E"
                   BackgroundColor="#2A2A3E"
                   ClearButtonVisibility="WhileEditing" />

            <!-- PIN Entry -->
            <Label Text="PIN (6 digits)" TextColor="White" FontSize="13" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,56" ColumnSpacing="12">
                <Entry Placeholder="••••••"
                       Text="{Binding Pin}"
                       IsPassword="{Binding IsPinHidden}"
                       MaxLength="6"
                       PlaceholderColor="#666" TextColor="#F7931E"
                       BackgroundColor="#2A2A3E"
                       Keyboard="Numeric"
                       ClearButtonVisibility="WhileEditing" />

                <Border
                    Grid.Column="1"
                    BackgroundColor="#2A2A3E"
                    HeightRequest="54"
                    Stroke="#3A3A50"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    WidthRequest="56">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TogglePinVisibilityCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <controls:IconLabel Glyph="{x:Static glyphs:IconGlyphs.Eye}" IconSize="24" IconColor="#F7931E" IsVisible="{Binding IsPinVisible}" />
                        <controls:IconLabel Glyph="{x:Static glyphs:IconGlyphs.EyeOff}" IconSize="26" IconColor="#F7931E" IsVisible="{Binding IsPinHidden}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Action Button -->
            <Button Text="Save Local Setup"
                    Command="{Binding SaveAndSyncCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="#F7931E"
                    TextColor="#092759"
                    CornerRadius="8"
                    FontSize="16"
                    FontAttributes="Bold"
                    Padding="16,12"
                    Margin="0,24,0,0" />

            <!-- Loading Indicator -->
            <StackLayout IsVisible="{Binding IsBusy}" HorizontalOptions="Center" Margin="0,16">
                <GraphicsView
                    x:Name="SetupLoadingSpinner"
                    HeightRequest="36"
                    WidthRequest="36" />
                <Label Text="{Binding StatusMessage}"
                       TextColor="#AAAACC"
                       HorizontalOptions="Center"
                       FontSize="12"
                       Margin="0,8,0,0" />
            </StackLayout>

            <!-- Error Message -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="#FF6B6B"
                   HorizontalOptions="Center"
                   IsVisible="{Binding HasError}"
                   FontSize="13"
                   FontAttributes="Bold"
                   Margin="0,16" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
